@page "/";



<h3>Consulta de Pessoas</h3>

<p>Pesquise por pessoas cadastradas no sistema</p>

<hr />

<table class="mt-2 table table-sm table-striped table-hover">

    <thead>
        <tr>

            <th>
                Nome
            </th>

            <th>
                Email
            </th>

            <th>
                Cadastrado em
            </th>

            <th>
                Ações
            </th>

        </tr>
    </thead>

    <tbody>

        @foreach (var p in pessoas) {

            <tr>

                <td>
                    @p.Nome
                </td>

                <td>
                    @p.Email
                </td>

                <td>
                    @p.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    <button class="btn btn-sm btn-outline-primary me-2">Editar</button>
                    <button class="btn btn-sm btn-outline-danger me-2">Excluir</button>
                </td>

            </tr>

        }


        
    </tbody>

    <tfoot>
        <tr>

            <td colspan="4">
                Quantidade de pessoas: @pessoas.Count
            </td>

        </tr>
    </tfoot>

</table>

@using PessoasApp.Blazor.Models
@inject HttpClient Http

@code {

    private List<Pessoa> pessoas = new();

    protected override async Task OnInitializedAsync() {

        pessoas = await Http.GetFromJsonAsync<List<Pessoa>>("api/pessoas") ?? new();

    }

}
